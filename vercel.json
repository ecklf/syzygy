{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "services": {
    "clues": {
      "root": "clues/"
    },
    "intercom": {
      "root": "intercom/",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/intercom",
      "destination": { "service": "intercom" }
    },
    {
      "source": "/media-stream",
      "destination": { "service": "intercom" }
    },
    {
      "source": "/beep.mp3",
      "destination": { "service": "intercom" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "clues" }
    }
  ],
  "build": {
    "env": {
      "VERCEL_RUST_BUN_LAYER": "arn:aws:lambda:AWS_REGION_PLACEHOLDER:338764639016:layer:vercel-rusty-runtime-bun-1_48_1-staging-c8e1c036cd-AWS_ARCH_PLACEHOLDER:1"
    }
  }
}
